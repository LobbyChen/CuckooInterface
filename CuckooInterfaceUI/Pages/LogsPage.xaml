<Page x:Class="CuckooInterfaceUI.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="LogsPage">
    <Grid Margin="28,24,28,20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="日志"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Core 运行日志"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <TextBlock x:Name="LogCountText"
                           Text="0 条"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <ui:Button x:Name="RefreshLogsButton"
                           Content="刷新"
                           Appearance="Secondary"
                           Margin="0,0,10,0"
                           Click="RefreshLogs_Click" />

                <ui:Button x:Name="ExportLogsButton"
                           Content="导出"
                           Appearance="Secondary"
                           Margin="0,0,10,0"
                           Click="ExportLogs_Click" />

                <ui:Button x:Name="ClearLogsButton"
                           Content="清空"
                           Appearance="Danger"
                           Click="ClearLogs_Click" />
            </StackPanel>
        </Grid>
        

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索消息或模块" TextChanged="SearchBox_TextChanged" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0" />
            <ComboBox x:Name="LevelFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="LevelFilter_SelectionChanged" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ComboBoxItem Content="所有级别" Tag="" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ComboBoxItem Content="DEBUG" Tag="DEBUG" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ComboBoxItem Content="INFO" Tag="INFO" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ComboBoxItem Content="WARN" Tag="WARN" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ComboBoxItem Content="ERROR" Tag="ERROR" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ComboBox>
        </Grid>
        <ui:Card Grid.Row="2" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="78" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="时间" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="级别" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="模块" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="消息" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid Grid.Row="1">
                    <ui:ListView x:Name="LogsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="42">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="78" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="11" Foreground="{Binding LevelColor}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Logger}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                    <StackPanel x:Name="LogsEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LogsEmptyTitle" Text="暂无日志" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LogsEmptyDetail" Text="Core 当前没有可显示的日志。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 分页控件 -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:Button x:Name="LogsPrevPageButton"
                                   Content="上一页"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"
                                   Click="LogsPrevPage_Click" />
                        <TextBlock x:Name="LogsPageIndicator"
                                   Text="第 1 / 1 页"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="LogsNextPageButton"
                                   Content="下一页"
                                   Appearance="Secondary"
                                   Click="LogsNextPage_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
