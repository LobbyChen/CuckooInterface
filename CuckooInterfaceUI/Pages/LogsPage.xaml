<Page x:Class="CuckooInterfaceUI.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="LogsPage"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <Storyboard x:Key="PageEntranceAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Margin="24" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="20" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEntranceAnimation}" />
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面头部 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="系统日志" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="查看系统运行状态、插件加载情况及错误信息。" 
                       FontSize="14" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 工具栏：搜索、过滤与操作 -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,20" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 搜索框 -->
                <ui:TextBox Grid.Column="0"
                            x:Name="SearchBox"
                            ToolTip="搜索日志内容或来源..."
                            Icon="{ui:SymbolIcon Search24}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />

                <!-- 级别过滤 -->
                <ComboBox Grid.Column="1"
                          x:Name="LevelFilter"
                          SelectedIndex="0"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          SelectionChanged="LevelFilter_SelectionChanged">
                    <ComboBoxItem Content="所有级别" IsSelected="True"/>
                    <ComboBoxItem Content="INFO"/>
                    <ComboBoxItem Content="WARN"/>
                    <ComboBoxItem Content="ERROR"/>
                    <ComboBoxItem Content="DEBUG"/>
                </ComboBox>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Delete24}"
                               Content="清空日志"
                               Margin="0,0,8,0"
                               Click="ClearLogs_Click" />
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowExportLtr24}"
                               Content="导出日志"
                               Click="ExportLogs_Click" />
                </StackPanel>
            </Grid>
        </ui:CardControl>

        <!-- 日志数据表格 -->
        <DataGrid Grid.Row="2" 
                  x:Name="LogsDataGrid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  BorderThickness="0"
                  RowHeight="36"
                  FontSize="13">
            
            <DataGrid.Columns>
                <!-- 时间列 -->
                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 级别列 (带颜色) -->
                <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding LevelColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 来源列 -->
                <DataGridTextColumn Header="来源/模块" Binding="{Binding Logger}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 消息列 (自动填充剩余宽度) -->
                <DataGridTextColumn Header="消息内容" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>