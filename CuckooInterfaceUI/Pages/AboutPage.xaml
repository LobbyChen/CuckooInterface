<Page x:Class="CuckooInterfaceUI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AboutPage">

    <Page.Resources>
        <Storyboard x:Key="PageEntranceAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid Margin="28,24,28,20"
          Opacity="0"
          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RenderTransform>
            <TranslateTransform Y="20" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEntranceAnimation}" />
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="关于" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="CuckooInterface 项目信息"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
            <StackPanel>
                <ui:Card Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Width="64"
                               Height="64"
                               Source="pack://application:,,,/CuckooInterfaceUI;component/Assets/icon.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Margin="16,0,16,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CuckooInterface"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="面向电教场景的下一代插件平台。"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="2"
                                   Content="访问 GitHub"
                                   Appearance="Primary"
                                   VerticalAlignment="Center"
                                   Click="OpenGitHub_Click" />
                    </Grid>
                </ui:Card>

                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="项目介绍"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock TextWrapping="Wrap"
                                   LineHeight="22"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="CuckooInterface 是一个面向电教场景的可扩展软件平台，也是一个 Windows 插件运行时与宿主管理平台。" />

                        <TextBlock TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="我们的目标是把零散的小工具收拢到一个可管理、可扩展的插件平台中，同时降低插件开发的语言门槛。" />
                        <TextBlock TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="我们给需要扩展电教系统能力的人提供统一的编程基础设施。" />
                        <Border Height="1"
                                Margin="0,18,0,14"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <TextBlock Text="主要能力"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="· 多语言运行时，可通过统一 ABI 扩展"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="20" />
                        <TextBlock Text="· 分层插件：Kernel 提供运行时，Base 提供事件，Active 消费事件"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="20" />
                        <TextBlock Text="· 插件管理：扫描、解压、加载、卸载、删除与外部安装"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="20" />
                        <TextBlock Text="开源协议：AGPL-3.0"
                                   Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
