<Page x:Class="CuckooInterfaceUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="SettingsPage">

    <Page.Resources>
        <!-- 选项卡样式：增强选中态可见性 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="应用程序偏好设置" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 选项卡 -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">

            <!-- 通用 -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="启动" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="开机自启动" FontWeight="SemiBold" />
                                        <TextBlock Text="登录系统后自动启动 CuckooInterface" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle" IsChecked="False" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="语言" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="界面显示语言" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                <ComboBox x:Name="LanguageCombo" Height="36" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="简体中文" IsSelected="True" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="日本語" />
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="单实例" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="仅允许运行一个实例" FontWeight="SemiBold" />
                                        <TextBlock Text="新启动的实例将通知旧实例退出" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="SingleInstanceToggle" IsChecked="True" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 外观 -->
            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="主题" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="应用主题" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                <ComboBox x:Name="ThemeCombo" Height="36" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="深色" IsSelected="True" />
                                    <ComboBoxItem Content="浅色" />
                                    <ComboBoxItem Content="跟随系统" />
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="强调色" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <UniformGrid x:Name="AccentColorContainer" Columns="5" HorizontalAlignment="Left">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#0078D4" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click" Tag="#0078D4" />
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#43B581" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click" Tag="#43B581" />
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#F5A623" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click" Tag="#F5A623" />
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#E5484D" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click" Tag="#E5484D" />
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#8B5CF6" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click" Tag="#8B5CF6" />
                                </UniformGrid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="字号缩放" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="FontScaleValue" Text="100%" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <Slider x:Name="FontScaleSlider" Minimum="80" Maximum="140" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="FontScaleSlider_ValueChanged" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 日志 -->
            <TabItem Header="日志">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="日志级别" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ComboBox x:Name="LogLevelCombo" Height="36" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Debug" />
                                    <ComboBoxItem Content="Info" IsSelected="True" />
                                    <ComboBoxItem Content="Warn" />
                                    <ComboBoxItem Content="Error" />
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="单文件最大大小 (MB)" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LogMaxSizeValue" Text="100 MB" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <Slider x:Name="LogMaxSizeSlider" Minimum="10" Maximum="500" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="LogMaxSizeSlider_ValueChanged" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="压缩旧日志" FontWeight="SemiBold" />
                                        <TextBlock Text="对超过保留天数的日志文件进行压缩" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="LogCompressToggle" IsChecked="False" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 插件 -->
            <TabItem Header="插件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="启动时自动加载插件" FontWeight="SemiBold" />
                                        <TextBlock Text="程序启动后自动扫描并加载所有已安装插件" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="AutoLoadPluginsToggle" IsChecked="True" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="插件目录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <DockPanel>
                                    <ui:TextBox x:Name="PluginDirTextBox" Text=".\plugins" IsReadOnly="True" DockPanel.Dock="Left" />
                                    <ui:Button Content="浏览" Appearance="Secondary" Margin="8,0,0,0" DockPanel.Dock="Right" />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="加载失败时继续" FontWeight="SemiBold" />
                                        <TextBlock Text="某个插件加载失败时不中断整体启动流程" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="ContinueOnErrorToggle" IsChecked="True" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 高级 -->
            <TabItem Header="高级">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="显示高级选项" FontWeight="SemiBold" />
                                        <TextBlock Text="开启后显示以下高级设置项" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" x:Name="ShowAdvancedToggle" IsChecked="False" VerticalAlignment="Center" Checked="ShowAdvancedToggle_Changed" Unchecked="ShowAdvancedToggle_Changed" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- 以下设置项由 ShowAdvancedToggle 控制显隐 -->
                        <StackPanel x:Name="AdvancedSettingsPanel" Visibility="Collapsed">

                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="守护进程" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="以守护模式启动" FontWeight="SemiBold" />
                                            <TextBlock Text="启用系统托盘并在后台保持运行" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" x:Name="DaemonModeToggle" IsChecked="True" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="IPC 命名管道" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <ui:TextBox x:Name="IpcPipeTextBox" Text="\\.\pipe\CuckooInterfaceBridge" />
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="Kernel 加载超时 (秒)" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="KernelTimeoutValue" Text="30 s" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DockPanel>
                                    <Slider x:Name="KernelTimeoutSlider" Minimum="5" Maximum="120" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="KernelTimeoutSlider_ValueChanged" />
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="事件 Worker 数量" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WorkerCountValue" Text="16" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DockPanel>
                                    <Slider x:Name="WorkerCountSlider" Minimum="1" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="WorkerCountSlider_ValueChanged" />
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="崩溃时自动重启 Kernel" FontWeight="SemiBold" />
                                            <TextBlock Text="Kernel 异常退出后自动尝试重新加载" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" x:Name="AutoRestartKernelToggle" IsChecked="False" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
