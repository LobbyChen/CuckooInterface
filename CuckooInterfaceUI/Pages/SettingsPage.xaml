<Page x:Class="CuckooInterfaceUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      xmlns:local="clr-namespace:CuckooInterfaceUI.Converters"
      Title="SettingsPage">

    <Page.Resources>

        <!--
            导航文字竖排转换：
            外观 -> 外
                 -> 观
        -->
        <local:VerticalTextConverter x:Key="VerticalTextConverter" />

    </Page.Resources>


    <Grid Margin="28,24,28,20"
          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

        <Grid.RowDefinitions>
            <!-- 顶部标题 -->
            <RowDefinition Height="Auto" />

            <!-- 主体内容 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- 顶部标题区域 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <!-- 左侧标题 -->
                <ColumnDefinition Width="Auto" />

                <!-- 中间自动占满 -->
                <ColumnDefinition Width="*" />

                <!-- 右侧操作区 -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- 页面标题 -->
            <!-- ===================================================== -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Top">

                <TextBlock Text="设置"
                           FontSize="28"
                           FontWeight="SemiBold" />

                <TextBlock Text="应用和 Core 全局设置"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            </StackPanel>


            <!-- ===================================================== -->
            <!-- 右上角操作区 -->
            <!-- ===================================================== -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">

                <!-- 未保存提示 -->
                <TextBlock x:Name="UnsavedChangesText"
                           Text="有未保存更改"
                           Foreground="{DynamicResource CuckooStatusWarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6,14,0"
                           Visibility="Collapsed" />

                <!-- 保存按钮 -->
                <ui:Button x:Name="SaveSettingsButton"
                           Content="保存"
                           Appearance="Primary"
                           IsEnabled="False"
                           Click="SaveSettings_Click" />

            </StackPanel>

        </Grid>


        <!-- ========================================================= -->
        <!-- 设置主体 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- 左侧竖排导航 -->
                <ColumnDefinition Width="72" />

                <!-- 间距 -->
                <ColumnDefinition Width="22" />

                <!-- 右侧内容 -->
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- 左侧导航 -->
            <!-- ===================================================== -->
            <ui:Card Grid.Column="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Padding="6">

                <Grid>

                    <!-- ================================================= -->
                    <!-- 设置导航 -->
                    <!-- ================================================= -->
                    <ui:ListView x:Name="SettingsNav"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 SelectionChanged="SettingsNav_SelectionChanged">

                        <!--
                            所有导航项平均分配整个导航区域高度。
                            
                            例如：
                            4 个页面 -> 每项 25%
                            5 个页面 -> 每项 20%
                        -->
                        <ui:ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ui:ListView.ItemsPanel>


                        <!-- ================================================= -->
                        <!-- 导航项内容 -->
                        <!-- ================================================= -->
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>

                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">

                                    <!--
                                        动态文字竖排：
                                        外观
                                        ↓
                                        外
                                        观
                                    -->
                                    <TextBlock Text="{Binding Name, Converter={StaticResource VerticalTextConverter}}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center" />

                                </Grid>

                            </DataTemplate>
                        </ui:ListView.ItemTemplate>

                    </ui:ListView>


                    <!-- ================================================= -->
                    <!-- 没有加载到设置 -->
                    <!-- ================================================= -->
                    <TextBlock x:Name="SettingsNavEmpty"
                               Text="未加载设置"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                </Grid>

            </ui:Card>


            <!-- ===================================================== -->
            <!-- 中间间距 -->
            <!-- ===================================================== -->
            <Grid Grid.Column="1" />


            <!-- ===================================================== -->
            <!-- 右侧设置内容 -->
            <!-- ===================================================== -->
            <ui:Card Grid.Column="2"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Padding="22">

                <Grid>

                    <!-- ================================================= -->
                    <!-- 动态设置页面 -->
                    <!-- ================================================= -->
                    <ContentControl x:Name="SettingsContent" />


                    <!-- ================================================= -->
                    <!-- Core 未连接状态 -->
                    <!-- ================================================= -->
                    <StackPanel x:Name="SettingsDisconnectedState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">

                        <TextBlock Text="Core 未连接"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="恢复连接后会自动重新加载设置。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />

                    </StackPanel>

                </Grid>

            </ui:Card>

        </Grid>

    </Grid>

</Page>