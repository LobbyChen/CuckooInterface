<Page x:Class="CuckooInterfaceUI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="HomePage">
    <Grid Margin="28,24,28,20"
          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 + 右上角操作按钮 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="概览"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Core 当前运行状态"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <ui:Button x:Name="RefreshHomeButton"
                           Content="刷新"
                           Appearance="Secondary"
                           Margin="0,0,10,0"
                           Click="RefreshHome_Click" />

                <ui:Button x:Name="RestartServiceButton"
                           Content="重启 Core"
                           Appearance="Primary"
                           Margin="0,0,10,0"
                           Click="RestartService_Click" />

                <ui:Button x:Name="StopServiceButton"
                           Content="停止 Core"
                           Appearance="Danger"
                           Click="StopService_Click" />
            </StackPanel>
        </Grid>

        <!-- Core 运行状态 -->
        <ui:Card Grid.Row="1"
                 Padding="18"
                 Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="RunStatusDot"
                         Width="10"
                         Height="10"
                         Fill="{DynamicResource CuckooStatusNeutralBrush}"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Margin="12,0,20,0">
                    <TextBlock x:Name="RunStatusText"
                               Text="检查中…"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RunStatusDetailText"
                               Text="正在连接 Core"
                               FontSize="12"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right">
                    <TextBlock Text="运行时间"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UptimeText"
                               Text="—"
                               FontSize="15"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 主体区域：左右等宽 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：运行数据 -->
            <ui:Card Grid.Column="0"
                     Padding="20">
                <StackPanel>
                    <TextBlock Text="运行数据"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="插件"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PluginCountText"
                                       Text="—"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="内核"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="KernelCount"
                                       Text="—"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="今日事件"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="EventCountText"
                                       Text="—"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="今日错误"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ErrorCountText"
                                       Text="—"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="内核"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="KernelNames"
                                   Grid.Column="1"
                                   Text="—"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="20,0,0,0" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 右侧：最近事件，与左侧等宽等高 -->
            <ui:Card Grid.Column="2"
                     Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="最近事件"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <ui:Button Grid.Column="1"
                                   Content="查看全部"
                                   Appearance="Secondary"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Click="ViewAllEvents_Click" />
                    </Grid>
                    


                    <Grid Grid.Row="1">
                        <ui:ListView x:Name="RecentEventsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="42"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Time}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EventName}"
                                                   FontSize="13"
                                                   Margin="10,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LevelText}"
                                                   FontSize="12"
                                                   Foreground="{Binding LevelColor}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>

                        <StackPanel x:Name="RecentEventsEmptyState"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="RecentEventsEmptyTitle"
                                       Text="暂无事件"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <TextBlock x:Name="RecentEventsEmptyDetail"
                                       Text="恢复连接后会自动刷新。"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
