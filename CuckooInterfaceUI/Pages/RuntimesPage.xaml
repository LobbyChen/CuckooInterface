<pages:AutoRefreshPage x:Class="CuckooInterfaceUI.Pages.RuntimesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:CuckooInterfaceUI.Pages"
      Title="RuntimesPage">

    <Page.Resources>
        <Style x:Key="MetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="MetaValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRootGrid">
    <Grid Margin="28,24,28,20"
          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="运行时"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="管理 Kernel 运行时、环境与运行参数"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <ui:Button x:Name="RefreshRuntimesButton"
                           Content="刷新"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="RefreshRuntimes_Click" />
                <ui:Button x:Name="RestartCoreButton"
                           Content="重启 Core"
                           Appearance="Primary"
                           Click="RestartCore_Click" />
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 运行时列表 -->
            <ui:Card Grid.Column="0" Padding="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Kernel 运行时"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="4,2,0,8" />

                    <ui:ListView x:Name="RuntimeList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="RuntimeList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,7" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Play24"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding VersionText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{Binding StatusColor}"
                                                 HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PluginCount, StringFormat={}{0} 插件}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>

                    <StackPanel x:Name="RuntimeListEmptyState"
                                Grid.Row="1"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="12,24">
                        <TextBlock Text="没有可用的 Kernel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="请将 Kernel 包放入 user/Kernel 后重启 Core。"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               x:Name="RuntimeListStatusText"
                               Text=""
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="4,8,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </ui:Card>

            <!-- 运行时详情 -->
            <ui:Card Grid.Column="2" Padding="22">
                <Grid>
                    <ScrollViewer x:Name="RuntimeDetailScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RuntimeDetailPanel" Margin="0,0,8,12">

                            <!-- 头部 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding VersionText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Margin="12,4,0,0">
                                    <Ellipse Width="9"
                                             Height="9"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Margin="6,0,10,0"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="7,3">
                                        <TextBlock Text="{Binding RuntimeText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <ui:InfoBar x:Name="RuntimeErrorInfoBar"
                                        Title="运行时异常"
                                        Severity="Error"
                                        IsClosable="True"
                                        IsOpen="False"
                                        Margin="0,0,0,12" />

                            <!-- 动态运行时选择（由 RuntimeManager 生成） -->
                            <Border x:Name="RuntimeSelectionCard"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <StackPanel x:Name="RuntimeSelectionHost" />
                                    <ui:InfoBar x:Name="RuntimeSelectionInfoBar"
                                                Title="运行时选择已保存"
                                                Message="重启 Core 后生效。"
                                                Severity="Informational"
                                                IsClosable="True"
                                                IsOpen="False"
                                                Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 元信息 -->
                            <TextBlock Text="运行时信息"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,10" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                                    <TextBlock Text="运行时类型" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="运行状态" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12">
                                    <TextBlock Text="Kernel 版本" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding KernelVersion}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="运行时版本" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding RuntimeVersion}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,12">
                                    <TextBlock Text="插件数量" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding PluginCount}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="运行时来源" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="运行时目录" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding Home}"
                                               Style="{StaticResource MetaValueStyle}"
                                               TextTrimming="None" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                    <TextBlock Text="控制面能力" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{Binding CapabilitiesText}" Style="{StaticResource MetaValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Kernel 动态设置 -->
                            <TextBlock Text="Kernel 设置"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <StackPanel x:Name="RuntimeSettingsHost" Margin="0,0,0,8" />
                            <TextBlock x:Name="RuntimeSettingsEmptyText"
                                       Text="该 Kernel 未提供运行时设置。"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,14" />

                            <!-- 操作 -->
                            <TextBlock Text="可用操作"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8" />
                            <WrapPanel x:Name="RuntimeOperationsHost" Margin="0,0,0,10" />
                            <TextBlock x:Name="RuntimeOperationsEmptyText"
                                       Text="该 Kernel 未声明运行时操作。"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,14" />

                            <!-- 诊断 -->
                            <TextBlock Text="运行时状态（原始 JSON）"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8" />
                            <ui:TextBox x:Name="RuntimeStateTextBox"
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="120"
                                        MaxHeight="220"
                                        VerticalScrollBarVisibility="Auto"
                                        FontFamily="Consolas"
                                        FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 未选择 / 断开 -->
                    <StackPanel x:Name="RuntimeDetailEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24">
                        <TextBlock x:Name="RuntimeDetailEmptyTitle"
                                   Text="选择一个运行时"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="RuntimeDetailEmptyDetail"
                                   Text="在左侧查看 Kernel 运行时信息、设置与操作。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
    </Grid>
</pages:AutoRefreshPage>
