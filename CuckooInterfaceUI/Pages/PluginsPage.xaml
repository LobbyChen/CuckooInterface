<pages:AutoRefreshPage x:Class="CuckooInterfaceUI.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:CuckooInterfaceUI.Pages"
      Title="PluginsPage">

    <Grid Margin="24" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="插件管理"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="管理内核、基础与应用插件"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <ui:Button x:Name="RefreshPluginsButton"
                           Content="刷新"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="RefreshButton_Click" />
                <ui:Button x:Name="InstallPluginButton"
                           Content="安装插件"
                           Icon="{ui:SymbolIcon Add24}"
                           Appearance="Primary"
                           Click="OpenInstallPanel_Click" />
            </StackPanel>
        </DockPanel>

        <ui:Card Grid.Row="1"
                 Padding="12"
                 Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">
                    <ComboBox x:Name="TypeFilter"
                              Width="140"
                              Margin="8,0,0,0"
                              SelectedIndex="0"
                              SelectionChanged="TypeFilter_SelectionChanged"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <ComboBoxItem Content="全部类型" Tag="" />
                        <ComboBoxItem Content="内核" Tag="kernel" />
                        <ComboBoxItem Content="基础" Tag="base" />
                        <ComboBoxItem Content="应用" Tag="active" />
                    </ComboBox>
                </StackPanel>

                <ui:TextBox x:Name="SearchBox"
                            PlaceholderText="搜索插件名称或 ID…"
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="SearchBox_TextChanged"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </ui:Card>

        <Grid Grid.Row="2">
            <ui:ListView x:Name="PluginsList"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,6" MinHeight="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Cube24"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,12,0"
                                        MinWidth="0"
                                        VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Version}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Margin="8,0,0,0">
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding TypeText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="6,0,0,0"
                                                ToolTip="插件运行时">
                                            <TextBlock Text="{Binding RuntimeText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                 IsEnabled="{Binding CanToggle}"
                                                 OffContent="已禁用"
                                                 OnContent="已启用"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Click="PluginToggle_Changed"
                                                 Tag="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Settings24}"
                                           Appearance="Secondary"
                                           Padding="6"
                                           Margin="0,0,4,0"
                                           ToolTip="插件设置 / 运行时详情"
                                           Tag="{Binding}"
                                           IsEnabled="{Binding CanOpenSettings}"
                                           Click="PluginSettings_Click" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Danger"
                                           Padding="6"
                                           Tag="{Binding}"
                                           IsEnabled="{Binding CanUninstall}"
                                           Click="DeletePlugin_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <StackPanel x:Name="PluginsEmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,24,0,24">
                <TextBlock x:Name="PluginsEmptyTitle"
                           Text="暂无插件"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="PluginsEmptyDetail"
                           Text="可以从右上角安装插件。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</pages:AutoRefreshPage>
