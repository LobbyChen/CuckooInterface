<Application x:Class="CuckooInterfaceUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:CuckooInterfaceUI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 统一应用状态与交互颜色。 -->
            <SolidColorBrush x:Key="CuckooStatusSuccessBrush" Color="#63D38B" />
            <SolidColorBrush x:Key="CuckooStatusWarningBrush" Color="#F2C35E" />
            <SolidColorBrush x:Key="CuckooStatusErrorBrush" Color="#FF7272" />
            <SolidColorBrush x:Key="CuckooStatusNeutralBrush" Color="#9AA0A6" />
        </ResourceDictionary>
    </Application.Resources>
</Application>


